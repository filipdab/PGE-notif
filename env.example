# Skopiuj do .env (obok pge_wylaczenia.py) i uzupełnij. Plik .env nie trafia do gita.

# Adresy do obserwowania — wymagane
PGE_ADRESY=Miasto: Ulica1, Ulica2; Inna Miejscowość: Ulica3
# Powiat — gdy w Polsce jest kilka miejscowości o tej nazwie (opcjonalnie)
#PGE_POWIAT=nazwa_powiatu

# Poczta (np. Gmail z hasłem aplikacji)
EMAIL_FROM=adres@gmail.com
EMAIL_PASSWORD=haslo-aplikacji
#SMTP_SERVER=smtp.gmail.com
#SMTP_PORT=465
#PGE_MAIL_TO=adresat1@example.com,adresat2@example.com

# SMS przez SMSAPI.pl (opcjonalnie)
#SMSAPI_TOKEN=
#SMS_TO=48500100200
